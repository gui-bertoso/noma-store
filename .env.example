# Modelo de secrets do Worker Noma Casa.
# Copie para .env.production.local, preencha localmente e importe com:
# npx wrangler secret bulk .env.production.local
#
# Nunca faça commit do arquivo preenchido, nunca coloque estes valores no
# frontend e nunca use o mesmo valor em produção e desenvolvimento.

# Token usado para proteger /api/admin/*.
# Gere um valor aleatório com pelo menos 32 bytes.
ADMIN_TOKEN=gere-um-token-aleatorio-com-mais-de-32-caracteres

# Stripe: somente no Worker, nunca no navegador.
# Produção: sk_live_... / Teste: sk_test_...
STRIPE_SECRET_KEY=sk_live_substitua_pela_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_substitua_pelo_signing_secret

# Integrações de fornecedor — reservados para quando o adaptador oficial for implementado.
# Não preencha nem importe chaves de Shopee/AliExpress antes de confirmar autorização
# da conta e os endpoints permitidos pela plataforma.
# SUPPLIER_API_BASE_URL=https://api.exemplo.com
# SUPPLIER_API_KEY=
# SUPPLIER_API_SECRET=

# Não coloque aqui CLOUDFLARE_API_TOKEN, CLOUDFLARE_API_KEY ou senhas do GitHub.
# Credenciais de deploy devem ficar no ambiente da CI/terminal, separadas do Worker.
